# --- Required ---
# 32+ char base64-encoded Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Admin API key — required for /admin/* endpoints. Use any random string.
ADMIN_API_KEY=change-me-in-prod

# --- LLM (LiteLLM handles many providers via env vars) ---
# Pick one. See https://docs.litellm.ai for full list.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=2024-08-01-preview

# Default LLM model if a tenant doesn't override it
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---
# Default: local SQLite. For production set to postgres URL like:
#   postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./platform.db

# --- App ---
LOG_LEVEL=INFO
